# Copie este ficheiro para .env.local e preencha com os valores do Supabase
# (Dashboard → Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# Chave secreta — NUNCA a exponha no browser nem a coloque no git.
# Usada apenas para apagar contas (direito ao apagamento).
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# URL público do site (para os links nos emails de confirmação)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 — só é carregado depois de o visitante aceitar cookies de análise
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Endereço secreto do painel da equipa: o painel fica em /<PANEL_SLUG>/entrar
# Use algo longo e aleatório. Sem esta variável, o painel fica desligado.
PANEL_SLUG=gestao-mude-isto-para-algo-aleatorio

# Avisos à equipa (novos pedidos, comentários dos colaboradores) — configurar com: npm run avisos
# (ver scripts/avisos.mjs). Telegram + cópia por email (precisa do SMTP abaixo).
# TELEGRAM_BOT_TOKEN=123456789:AAH...
# STAFF_TELEGRAM=123456789
# ADMIN_TELEGRAM=123456789
# STAFF_EMAIL=equipa@exemplo.pt
# ADMIN_EMAIL=sandra@exemplo.pt

# Email automático de confirmação ao cliente (ver src/lib/mailer.ts). Para testar com Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=o-seu-email@gmail.com
# SMTP_PASS=palavra-passe-de-aplicacao
# SMTP_FROM="Lareiras Pachinha <o-seu-email@gmail.com>"

# WhatsApp da empresa, para o cliente falar connosco (botão no comprovativo). Ex.: 351912345678
# NEXT_PUBLIC_COMPANY_WHATSAPP=
